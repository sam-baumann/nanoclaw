#!/usr/bin/env node
// ics-fetch — fetch and parse an ICS calendar URL
// Usage: node ics-fetch <url> [--days N] [--past N] [--json]
//   --days N   show events in the next N days (default: 30)
//   --past N   also include events up to N days in the past (default: 0)
//   --json     output raw JSON instead of readable text

const https = require('https');
const http = require('http');

const args = process.argv.slice(2);
if (args.length === 0 || args[0] === '--help') {
  console.log('Usage: node ics-fetch <url> [--days N] [--past N] [--json]');
  process.exit(0);
}

const calUrl = args[0];
const daysIdx = args.indexOf('--days');
const days = daysIdx >= 0 ? parseInt(args[daysIdx + 1], 10) : 30;
const pastIdx = args.indexOf('--past');
const pastDays = pastIdx >= 0 ? parseInt(args[pastIdx + 1], 10) : 0;
const jsonOutput = args.includes('--json');

function fetchUrl(urlStr, redirectCount = 0) {
  return new Promise((resolve, reject) => {
    if (redirectCount > 5) return reject(new Error('Too many redirects'));
    // Handle webcal:// scheme
    const normalized = urlStr.replace(/^webcal:\/\//i, 'https://');
    const mod = normalized.startsWith('https://') ? https : http;
    mod.get(normalized, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location) {
        return fetchUrl(res.headers.location, redirectCount + 1).then(resolve).catch(reject);
      }
      if (res.statusCode !== 200) {
        return reject(new Error(`HTTP ${res.statusCode}`));
      }
      let data = '';
      res.on('data', chunk => { data += chunk; });
      res.on('end', () => resolve(data));
    }).on('error', reject);
  });
}

function parseDate(dtStr) {
  // Strip VALUE=DATE: prefix if present, get just the value
  const val = dtStr.includes(':') ? dtStr.split(':').pop() : dtStr;
  const s = val.replace(/Z$/, '');
  if (s.length === 8) {
    // Date-only: YYYYMMDD — treat as local midnight
    return new Date(`${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}T00:00:00`);
  }
  // DateTime: YYYYMMDDTHHmmss[Z]
  return new Date(
    `${s.slice(0,4)}-${s.slice(4,6)}-${s.slice(6,8)}T${s.slice(9,11)}:${s.slice(11,13)}:${s.slice(13,15)}`
  );
}

function parseIcs(text) {
  // Unfold RFC 5545 line folding (CRLF + whitespace = continuation)
  const unfolded = text.replace(/\r\n[ \t]/g, '').replace(/\r\n/g, '\n').replace(/\r/g, '\n');

  const events = [];
  const lines = unfolded.split('\n');
  let inEvent = false;
  let current = {};

  for (const line of lines) {
    const trimmed = line.trim();
    if (trimmed === 'BEGIN:VEVENT') {
      inEvent = true;
      current = {};
    } else if (trimmed === 'END:VEVENT') {
      inEvent = false;
      if (current.SUMMARY || current.DTSTART) events.push(current);
    } else if (inEvent) {
      const colonIdx = line.indexOf(':');
      if (colonIdx < 0) continue;
      // Key may include params: DTSTART;TZID=America/New_York
      const keyPart = line.slice(0, colonIdx).split(';')[0].toUpperCase().trim();
      const val = line.slice(colonIdx + 1).trim();
      const keep = ['SUMMARY', 'DESCRIPTION', 'LOCATION', 'DTSTART', 'DTEND', 'UID', 'URL'];
      if (keep.includes(keyPart)) {
        current[keyPart] = val;
      }
    }
  }
  return events;
}

function formatDate(d) {
  return d.toLocaleDateString('en-US', {
    weekday: 'short', year: 'numeric', month: 'short', day: 'numeric',
  });
}

function unescape(s) {
  return (s || '').replace(/\\n/g, ' ').replace(/\\,/g, ',').replace(/\\;/g, ';').replace(/\\\\/g, '\\').trim();
}

async function main() {
  const icsText = await fetchUrl(calUrl);
  const events = parseIcs(icsText);

  const now = new Date();
  const start = new Date(now.getTime() - pastDays * 86400000);
  const end = new Date(now.getTime() + days * 86400000);

  const filtered = events
    .filter(e => {
      if (!e.DTSTART) return false;
      try {
        const d = parseDate(e.DTSTART);
        return d >= start && d <= end;
      } catch {
        return false;
      }
    })
    .sort((a, b) => parseDate(a.DTSTART) - parseDate(b.DTSTART));

  if (jsonOutput) {
    console.log(JSON.stringify(filtered.map(e => ({
      title: unescape(e.SUMMARY),
      start: e.DTSTART,
      end: e.DTEND || null,
      description: unescape(e.DESCRIPTION),
      location: unescape(e.LOCATION),
      url: e.URL || null,
    })), null, 2));
    return;
  }

  if (filtered.length === 0) {
    console.log(`No events found in the next ${days} days${pastDays > 0 ? ` (or past ${pastDays} days)` : ''}.`);
    return;
  }

  for (const e of filtered) {
    const d = parseDate(e.DTSTART);
    const title = unescape(e.SUMMARY) || '(no title)';
    console.log(`${formatDate(d)}: ${title}`);
    const desc = unescape(e.DESCRIPTION);
    if (desc) console.log(`  ${desc.slice(0, 120)}`);
  }
}

main().catch(e => {
  console.error('Error:', e.message);
  process.exit(1);
});
